{
  "name": "loomctx-sdk",
  "version": "0.2.0",
  "description": "Thin, dependency-free TypeScript client for the LoomCtx context engine",
  "keywords": ["loomctx", "agents", "context", "mcp", "provenance", "security", "sdk"],
  "homepage": "https://loomctx.dev",
  "bugs": { "url": "https://github.com/seahop/loomctx/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/seahop/loomctx.git", "directory": "sdk/typescript" },
  "license": "Apache-2.0",
  "author": "seahop",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "src", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "gen": "node scripts/gen.mjs ${LOOMCTX_SCHEMAS:-../../contracts/schemas.json} src/contracts.ts",
    "check-gen": "node scripts/gen.mjs ${LOOMCTX_SCHEMAS:-../../contracts/schemas.json} /tmp/contracts.ts && diff /tmp/contracts.ts src/contracts.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.6.0"
  }
}
