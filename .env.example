# Copy to `.env` and fill in — docker compose reads it automatically.
# `.env` is gitignored and dockerignored: secrets never reach the repo or images.
# (no inline comments after values — not every .env parser strips them, and
# `kubectl create secret --from-env-file` keeps them in the value)

# ---- Where the ports bind -----------------------------------------------------
# Compose publishes the engine (:8000), the scale-shape lb (:8081) and the MCP
# http transport (:8300) on localhost only. Set 0.0.0.0 to reach them from the
# LAN — and put keys on first (below), or everyone on the network has rw.
# LOOMCTX_BIND=127.0.0.1

# ---- Answering LLM (docs/decisions.md D-012) --------------------------------
# Enables POST /v1/answer, the MCP `answer` tool, and the e2e answer test
# (tests/test_e2e_answer.py — skipped when these are unset).

# Option A: a hosted provider shortcut + key.
# Shortcuts: openrouter | venice | openai | groq | together | mistral | anthropic
LOOMCTX_LLM_PROVIDER=openrouter
LOOMCTX_LLM_API_KEY=
LOOMCTX_LLM_MODEL=deepseek/deepseek-chat-v3.1

# Option B: your own endpoint (overrides the provider shortcut)
# LOOMCTX_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOOMCTX_LLM_MODEL=llama3.1:8b

# ---- Agent evaluation (D-036/D-037): `docker compose exec loomctx python -m loomctx.agent_eval`
# LOOMCTX_AGENT_MODEL=google/gemini-3.5-flash-lite   # the model that plays the agent (default: LOOMCTX_LLM_MODEL)
# LOOMCTX_AGENT_MAX_STEPS=20                         # model turns per task before it is cut off

# ---- MCP (docs/sdk.md) ---------------------------------------------------------
# A deployment that serves one team can default the `namespace` argument of
# every MCP tool; applies to the stdio server (`docker compose run … loomctx
# python -m loomctx.mcp_server`) and the `mcp` http profile alike.
# LOOMCTX_MCP_NAMESPACE=netsec
# 0 hides record_claim (agents can only read) / run_query and the `queries`
# describe_namespace lists. Both on by default (docs/mcp-clients.md).
# LOOMCTX_MCP_WRITES=0
# LOOMCTX_MCP_QUERIES=0

# ---- Embeddings for semantic ranking + doc excerpts (D-018/D-020) -----------
# Configured on the serving engine, the `mcp` profile AND the enrichment
# worker: the worker embeds observations and document chunks; the engine /
# MCP server embed the query at read time to rank them, surface doc_excerpt
# passages and serve `find_related`. Unset => keyword ranking, facts only, no
# excerpts (still works, just not semantic). Provider must expose an
# OpenAI-compatible /embeddings endpoint; "hashing" is an offline,
# dependency-free, non-semantic fallback.
# LOOMCTX_EMBED_PROVIDER=openai
# LOOMCTX_EMBED_MODEL=text-embedding-3-small
# LOOMCTX_EMBED_API_KEY=
# LOOMCTX_EMBED_BASE_URL=http://host.docker.internal:11434/v1
# LOOMCTX_EMBED_BATCH=512                # observations per embedder call for the worker (default 128)
# LOOMCTX_EMBED_DIM=512                  # Matryoshka output size (text-embedding-3-*, qwen3-embedding); a third of the storage at 1536
# LOOMCTX_EMBED_QUERY_TIMEOUT=10         # seconds the READ path waits for the query embedding before falling back to keywords
# LOOMCTX_CHUNK_LIMIT=4                  # documents the worker chunks per tick (D-039)

# ---- Entity resolution, tier 3 (D-042) -----------------------------------------
# Entity types whose vendor:product keys get structural alias candidates,
# LLM-adjudicated by the worker each tick and by `python -m loomctx.enrich
# resolve`. Each candidate is one model call (~283 on the vulnerability
# corpus, ~3 cents with a flash-class judge). Off when unset.
# LOOMCTX_ALIAS_TYPES=product

# ---- Read-side budget ceiling (docs/decisions.md D-020) ---------------------
# Hard cap on a request's token budget; raise for deployments that read large
# documents back. Default 32000.
# LOOMCTX_MAX_BUDGET=32000

# ---- API keys (docs/decisions.md D-013/D-013a) ------------------------------
# Preferred: a keys file with hashed keys + scoping gates, generated by
# `python -m loomctx.keys generate` (defaults to secrets/keys.json, written
# atomically with mode 0600) and mounted into the containers. Both the
# engine and gateway hot-reload it, so rotation needs no restart.
# LOOMCTX_AUTH_FILE=/secrets/keys.json
#
# Simple/legacy: plaintext entries key:namespace:perms (r/w/rw, * = all ns).
# Unset = auth disabled (open dev mode; the engine logs a warning).
# LOOMCTX_API_KEYS=agentsecret:netsec:w,dashsecret:netsec:r,rootsecret:*:rw

# ---- Request size cap on the engine (default 2 MiB; the gateway has its own)
# LOOMCTX_MAX_BODY_BYTES=2097152
# LOOMCTX_MAX_BATCH=1000                 # envelopes per /v1/ingest/batch request

# ---- Rate limits (docs/administration.md "Rate limits") ---------------------
# Per key (per client IP in open dev mode). Unset = unlimited. Applied by the
# engine (every /v1 route), the MCP http transport (per tool call) and the
# gateway (ingest; a batch of n envelopes costs n). Buckets live in each
# process: the effective ceiling for one key is rate x LOOMCTX_WORKERS x replicas.
# A batch larger than the burst is refused (413), so size the burst for your
# shippers' batch size. Per-key overrides live in the keys file.
# LOOMCTX_RATE_PER_SEC=20
# LOOMCTX_RATE_BURST=500
# LOOMCTX_RATE_LLM_PER_SEC=0.2           # /v1/answer, semantic search, MCP answer/find_related
# LOOMCTX_RATE_LLM_BURST=2

# ---- Host / Origin allowlist (docs/decisions.md D-059) -----------------------
# Blocks DNS rebinding and cross-site browser requests against a LoomCtx on your
# machine or LAN. Always allowed: localhost, IP addresses, single-label
# service names (loomctx, mcp, loomctx-gateway) and *.svc / *.svc.cluster.local /
# *.cluster.local / *.internal. Serving LoomCtx under a real DNS name (an
# ingress, a reverse proxy)? List it here, or every request gets a 400.
# "*" disables the Host check (only behind a proxy that validates Host).
# LOOMCTX_ALLOWED_HOSTS=loomctx.example.com,*.corp.example.com
# Browser origins allowed to call LoomCtx cross-origin (loopback ones, e.g. the
# MCP Inspector, always are). Other clients send no Origin and are unaffected.
# LOOMCTX_ALLOWED_ORIGINS=https://app.example.com

# ---- Expansion-handle signing (docs/decisions.md D-021) ---------------------
# Optional. When set, /v1/ask handles are HMAC-signed and only handles this
# deployment issued are accepted by /v1/expand. Share the same value across
# engine replicas; rotating it invalidates outstanding handles. Unset =
# unsigned handles (the engine warns at startup).
# LOOMCTX_HANDLE_SECRET=

# ---- Store override (docs/decisions.md D-011) -------------------------------
# Unset = SQLite on the volume. Point at Postgres to run the scaling lane:
# LOOMCTX_DB=postgresql://loomctx:loomctx@postgres:5432/loomctx
# Postgres-only dials (D-028), all optional:
# LOOMCTX_WORKERS=2            # uvicorn worker processes per engine container
# LOOMCTX_DB_POOL=4            # connections per worker
# LOOMCTX_DB_READ=postgresql://loomctx:loomctx@replica:5432/loomctx   # read-replica DSN
# Tenant sharding (D-032): namespace -> connection string, inline JSON or a file path
# LOOMCTX_SHARDS={"acme": "postgresql://loomctx:loomctx@acme-db:5432/loomctx"}
# Artifact offload (D-033): bodies above the threshold go to a blob store
# LOOMCTX_BLOB_THRESHOLD=262144
# LOOMCTX_BLOB_DIR=/data/blobs                      # a shared volume, or:
# LOOMCTX_BLOB_S3_BUCKET=loomctx  LOOMCTX_BLOB_S3_ENDPOINT=http://minio:9000  (+ AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)

# ---- Scale-profile queue dials (D-029), all optional ---------------------------
# LOOMCTX_STREAM_REPLICAS=1          # = NATS cluster size (compose: 1)
# LOOMCTX_STREAM_MAX_BYTES=1073741824
# LOOMCTX_STREAM_DISCARD=old         # old: shed oldest when full; new: refuse publishes
# LOOMCTX_ACK_WAIT=30                # consumer redelivery wait (s)
# LOOMCTX_MAX_DELIVER=5              # then parked on LOOMCTX_DEADLETTER
# LOOMCTX_DEADLETTER_MAX_BYTES=268435456   # dead-letter stream cap (default 256 MiB, oldest shed)

# ---- Kafka / Redpanda consumer (D-034, `kafka` profile) ------------------------
# LOOMCTX_KAFKA_BROKERS=redpanda:9092
# LOOMCTX_KAFKA_TOPICS=loomctx.ingest
# LOOMCTX_KAFKA_GROUP=loomctx-writer
# LOOMCTX_KAFKA_DEADLETTER=loomctx.deadletter
# Broker security. These authenticate LOOMCTX TO THE BROKER and encrypt the
# hop; they are not per-message auth. ANYONE WHO CAN PRODUCE TO THE TOPIC
# CAN WRITE ANY NAMESPACE — the topic's ACL is the write permission.
# LOOMCTX_KAFKA_SECURITY_PROTOCOL=SASL_SSL     # PLAINTEXT (default) | SSL | SASL_PLAINTEXT | SASL_SSL
# LOOMCTX_KAFKA_SASL_MECHANISM=SCRAM-SHA-256   # PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
# LOOMCTX_KAFKA_SASL_USERNAME=
# LOOMCTX_KAFKA_SASL_PASSWORD=
# LOOMCTX_KAFKA_SSL_CAFILE=/secrets/kafka-ca.pem   # private CA; system roots when unset
